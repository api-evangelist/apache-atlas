{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apache Atlas REST Discovery Glossary API",
    "version": "2.3.0"
  },
  "items": [
    {
      "info": {
        "name": "Glossary",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Apache Atlas List Glossaries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:21000/api/atlas/v2/glossary",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of glossaries to return."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of glossaries to skip."
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Retrieve all business glossaries with optional pagination."
        },
        {
          "info": {
            "name": "Apache Atlas Create Glossary",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:21000/api/atlas/v2/glossary",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Create a new business glossary."
        }
      ]
    }
  ],
  "bundled": true
}