      "item": [
        {
          "id": "d65513be-0b9f-4c02-96c8-cecd67a1f16f",
          "name": "Apache Atlas Basic Search",
          "request": {
            "name": "Apache Atlas Basic Search",
            "description": {
              "content": "Search for entities using a basic query with filters on type, classification, and attribute values.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "search",
                "basic"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "typeName",
                  "value": "<string>",
                  "description": "Filter results by entity type name."
                },
                {
                  "disabled": false,
                  "key": "classification",
                  "value": "<string>",
                  "description": "Filter by classification/tag applied to the entity."
                },
                {
                  "disabled": false,
                  "key": "query",
                  "value": "<string>",
                  "description": "Attribute-based query string."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum number of results to return."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<integer>",
                  "description": "Number of results to skip for pagination."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            }
          },
