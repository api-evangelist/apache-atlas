          "name": "Apache Atlas Get Lineage by GUID",
          "request": {
            "name": "Apache Atlas Get Lineage by GUID",
            "description": {
              "content": "Retrieve data lineage graph for an entity by its GUID, showing upstream and downstream dependencies.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "lineage",
                ":guid"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "direction",
                  "value": "BOTH",
                  "description": "Lineage direction (INPUT, OUTPUT, BOTH)."
                },
                {
                  "disabled": false,
                  "key": "depth",
                  "value": "<integer>",
                  "description": "Number of hops to traverse in the lineage graph."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "guid",
                  "description": "(Required) Unique identifier (GUID) of the entity."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            }
          },
